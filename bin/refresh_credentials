# Refresh credentials required to release suite scheduler.
set -eu

readonly SCRIPT_DIR="$(dirname "$(realpath -e "${BASH_SOURCE[0]}")")"
readonly SUITE_SCHEDULER_PATH=$SCRIPT_DIR/..
readonly CREDENTIALS_PATH=$SUITE_SCHEDULER_PATH/credentials

rm -rf $CREDENTIALS_PATH
gsutil cp -r gs://suite-scheduler.google.com.a.appspot.com/credentials/ \
  $SUITE_SCHEDULER_PATH
