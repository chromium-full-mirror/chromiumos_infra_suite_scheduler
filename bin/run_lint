# This script will start glint for current module.

set -eu

readonly bin_dir=$(readlink -f -- "$(dirname -- "$0")")

if (( $# == 0 )); then
    echo "No file specified. Linting all files managed by git." >&2
    cd "${bin_dir}/.."
    git ls-files | xargs -d '\n' /usr/bin/glint
    exit 0
fi

exec "/usr/bin/glint" "$@"
