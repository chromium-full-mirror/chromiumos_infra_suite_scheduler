# Run unit tests.
set -eu

readonly bin_dir="$(readlink -e -- "$(dirname -- "$0")")"

cd "${bin_dir}/.."

find . -name "*.pyc" -delete

exec "${bin_dir}/python_venv" runner.py "$@"
