# Setup environment necessary for development and release of suite-scheduler.
set -eu

readonly bin_dir="$(readlink -e -- "$(dirname -- "$0")")"
readonly set_up_script="${bin_dir}/../setup_environment.py"
readonly install_gcp_script="${bin_dir}/install_gcp_reqs"


${install_gcp_script}

exec "${bin_dir}/python_venv" "${set_up_script}" "$@"
